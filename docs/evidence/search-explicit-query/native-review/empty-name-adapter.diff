 export async function attachOwnedBlank(br){const websocket=new URL(br("get","cdp-url").trim());assert.ok(["127.0.0.1","localhost"].includes(websocket.hostname));const targets=await(await fetch("http://127.0.0.1:"+websocket.port+"/json/list")).json(),pages=targets.filter(t=>t.type==="page"&&t.url==="about:blank");assert.equal(pages.length,1,"Only the owned blank page may be controlled");const target=pages[0],ws=new WebSocket(target.webSocketDebuggerUrl);await new Promise((resolve,reject)=>{ws.addEventListener("open",resolve,{once:true});ws.addEventListener("error",reject,{once:true});});let next=0;const pending=new Map(),requests=[],errors=[];ws.addEventListener("message",event=>{const data=JSON.parse(event.data);if(data.id){const p=pending.get(data.id);if(p){pending.delete(data.id);data.error?p.reject(Error(data.error.message)):p.resolve(data.result);}return;}if(data.method==="Network.requestWillBeSent"&&data.params.type==="Document")requests.push({requestId:data.params.requestId,frameId:data.params.frameId,method:data.params.request.method,url:data.params.request.url});if(data.method==="Network.responseReceived"&&data.params.type==="Document"){const r=requests.findLast(r=>r.requestId===data.params.requestId);if(r)r.status=data.params.response.status;}if(data.method==="Runtime.exceptionThrown")errors.push({text:data.params.exceptionDetails.text,description:data.params.exceptionDetails.exception?.description?.slice(0,1500)});});const send=(method,params={})=>new Promise((resolve,reject)=>{const id=++next;pending.set(id,{resolve,reject});ws.send(JSON.stringify({id,method,params}));});await send("Network.enable");await send("Runtime.enable");return{targetId:target.id,requests,errors,send,close(){ws.close();}};}
